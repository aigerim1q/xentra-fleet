# Self-hosted Jira (Data Center/Server), Bearer auth via Personal Access Token
JIRA_BASE_URL=https://j.isaqr.kz
# Jira → avatar → Profile → Personal Access Tokens → Create token
JIRA_PAT=
# Jira project key, and exact workflow status names (for transitions only —
# picking up work uses statusCategory = "To Do", not a literal name)
JIRA_PROJECT_KEY=XEN
JIRA_IN_PROGRESS_STATUS=В работе
JIRA_REVIEW_STATUS=Review

# GitLab personal/project access token with "api" scope, for opening MRs.
# Pushing the branch itself uses your existing git credentials (SSH/https),
# not this token.
GITLAB_BASE_URL=https://gitlab.digal.kz
# Prefer a project access token on saqr/back-ai and saqr/front-ai, role Developer,
# scope "api" — Developer cannot push to protected dev/master.
GITLAB_TOKEN=
GITLAB_TARGET_BRANCH=dev

# Local checkouts the harness commits into. [backend]/[frontend] in a
# ticket's title or description routes it to one of these.
#
# _VERIFY_CMD is the required "test" gate. _GATE_TYPECHECK/_GATE_LINT/_GATE_BUILD are
# optional extra gates, each run and baseline-compared independently (not just one
# combined command) — a repo with none of them configured behaves exactly as before.
# Order: typecheck, lint, test, build. All failing gates are reported to the agent
# together in one feedback prompt, not one gate per iteration.
# If BOTH BACKEND_REPO_PATH and FRONTEND_REPO_PATH are set, a ticket tagged with both
# [backend] and [frontend]/[web] is handled as a cross-repo task (backend implemented
# first, its real diff handed to the frontend as context) instead of being skipped.
BACKEND_REPO_PATH=/Users/aigera/WebstormProjects/fleet/back-ai
BACKEND_VERIFY_CMD=yarn test
BACKEND_GATE_TYPECHECK=yarn tsc --noEmit
# Lint only the files the thread changed (a full-repo eslint run on back-ai needs a 4 GB
# Node heap and fails on old problems the agent didn't cause):
BACKEND_GATE_LINT=sh /Users/aigera/WebstormProjects/xentra-fleet/scripts/lint-changed.sh origin/dev
BACKEND_GATE_BUILD=yarn build
BACKEND_GITLAB_PROJECT=saqr/back-ai
# How to run exactly one acceptance-test file (see ACCEPTANCE_TESTS_ENABLED below).
# `npx <runner>` on purpose, not `yarn test <path>` — reproduced live: a plain `yarn
# test` run on a yarn-1.x repo silently rewrote package.json's packageManager field as
# a side effect, which would otherwise leak into the task's own commit on every
# iteration (this gate runs every iteration). npx sidesteps yarn entirely. Extension
# must match what this repo's test runner actually discovers (jest here: testRegex
# `.*\.spec\.ts$` under rootDir "src").
BACKEND_ACCEPTANCE_RUNNER=npx jest
BACKEND_ACCEPTANCE_TEST_EXT=spec.ts

FRONTEND_REPO_PATH=/Users/aigera/WebstormProjects/fleet/front-ai
FRONTEND_VERIFY_CMD=yarn test
FRONTEND_GATE_TYPECHECK=yarn tsc --noEmit
FRONTEND_GATE_LINT=yarn lint
FRONTEND_GATE_BUILD=yarn build
FRONTEND_GITLAB_PROJECT=saqr/front-ai
# vitest here: `include: ["src/**/*.test.ts", "src/**/*.test.tsx"]` — note .test.ts,
# not .spec.ts like back-ai's jest. Use .test.tsx (not .test.ts): a React-component
# acceptance test needs real JSX, and tsc only parses JSX in a .tsx file — a JSX
# acceptance test saved as .test.ts fails tsc with a cascade of syntax errors that
# don't look extension-related at all (reproduced live, XEN-539).
FRONTEND_ACCEPTANCE_RUNNER=npx vitest run
FRONTEND_ACCEPTANCE_TEST_EXT=test.tsx

# Model per role, each independently overridable. Defaults: Haiku for the chat
# classifier (fires on every stray Telegram message, needs to be fast/cheap, not
# strong reasoning), Sonnet for the read-only propose/analysis turn and for writing
# the acceptance test (needs real codebase understanding but is one bounded turn, not
# an open-ended loop), Opus for the actual implement+verify loop (quality there
# directly affects success rate).
CHAT_MODEL=claude-haiku-5-5
PROPOSE_MODEL=claude-opus-5-5
IMPLEMENT_MODEL=claude-sonnet-5-5
ACCEPTANCE_MODEL=claude-sonnet-5-5
# Judging "is this a durable fact worth remembering" and merging it cleanly into an
# existing notes file (no dupes/noise) needs real judgment but is one read-only turn
# per *successful* task, not a loop — same tier as propose/acceptance.
MEMORY_MODEL=claude-sonnet-5-5
# Catching what gates structurally can't (architecture, security, edge cases no test
# covers) needs real capability, not just a bounded turn to save cost — same tier as
# implement, not propose/acceptance/memory. Deliberately a DIFFERENT model lineage from
# IMPLEMENT_MODEL (not just a smaller/cheaper one) — a reviewer built the same way as
# the implementer is likely to share its blind spots, not just its strengths. Same
# reasoning ETS Tender uses a different model for its own review role.
# Fable 5.1 needs separate usage credits on a regular subscription — Opus by default.
REVIEW_MODEL=claude-opus-5-5
# Second, independent reviewer on another provider (Codex CLI, ChatGPT login via
# `codex login`). Runs in parallel with REVIEW_MODEL, read-only sandbox, no MCP; a
# blocking finding from either reviewer blocks. Empty model or ENABLED=false turns it off.
CODEX_REVIEW_ENABLED=true
CODEX_REVIEW_MODEL=gpt-6-astra
CODEX_REVIEW_EFFORT=high
CODEX_REVIEW_TIMEOUT_MS=1200000
# Writing a tester's walkthrough from a diff + task description is the same bounded-
# judgment shape as propose/acceptance/memory, not an open-ended loop — same tier.
TESTING_MODEL=claude-haiku-5-5
# Same bounded-judgment shape again — translating a diff into a few plain-language
# sentences for a non-technical audience, not raw capability. Same tier.
REPORT_MODEL=claude-haiku-5-5

# Turns a task's frozen acceptance criteria (see propose/approve flow) into a real,
# executable test file written BEFORE implementation starts — so it genuinely fails
# first (no fix exists yet), then gates every iteration as a strict pass/fail check
# implement is mechanically denied Edit/Write on (src/__acceptance__/<task-id>.<ext>).
# On by default; this one kill switch turns it off everywhere without touching the
# gate/model config above. Adds one extra Claude turn's cost/time per approved task.
ACCEPTANCE_TESTS_ENABLED=true

# After a task is verified and committed, a read-only turn decides whether anything
# durable happened (a non-obvious gotcha, a reason behind a decision) worth recording
# in <repo>/.claude/memory/jira-harness.md for future tasks — most tasks won't have
# anything worth writing, and the turn correctly says so instead of forcing an entry.
# This file is separate from any existing team-maintained .claude/memory/MEMORY.md
# (read as context, never written to — a repo's own curated memory shouldn't be
# rewritten by an automated process). One extra cheap turn per *successful* task.
MEMORY_ENABLED=true

# After every real success (gates passed, commit made), a read-only turn reviews the
# full diff for what gates structurally can't catch — architecture, security, edge
# cases no test covers. A blocking finding doesn't go straight to a human: it's handed
# back to the SAME implement session as a fix request, gates re-run, reviewer looks
# again — up to MAX_REVIEW_ROUNDS rounds before actually escalating to needs_human.
# Nonblocking findings ride along in the MR description, never stop anything. On by
# default; one extra Opus turn's cost per round.
REVIEW_ENABLED=true
# Caps the reviewer<->developer back-and-forth — two agents that never agree need a
# hard stop, same reasoning as MAX_ITERATIONS for the gate-fixing loop.
MAX_REVIEW_ROUNDS=3

# Briefing prepended to the PM and first dev prompt, built without a model: Jira card,
# the last N comments, the task's MR and its pipeline. Any source that fails or misses
# the deadline becomes an "unavailable" line; the task starts regardless.
CONTEXT_PACK_ENABLED=true
CONTEXT_PACK_COMMENTS=3
CONTEXT_PACK_TIMEOUT_MS=15000

# Modeled on ETS Tender's own production "брифы": if implement hits genuine ambiguity,
# it's instructed to stop and ask (a structured question + options + recommendation,
# answered with one click in Telegram) instead of guessing. Costs nothing extra — it's
# a different shape of the SAME implement turn's response, not a separate turn. The
# toggle exists for debugging/rollback.
BRIEFS_ENABLED=true

# After every real success, a read-only turn writes a Предусловия/Шаги/Ожидаемый
# результат walkthrough for a human tester (no code references — screens/buttons/
# endpoints, same as a manual bug report) and it's posted straight into the Jira
# success comment next to the MR link. Purely informational, never blocks anything.
# On by default; one extra Sonnet-tier turn's cost per *successful* task.
TESTING_NOTES_ENABLED=true

# After every real success, a read-only turn writes a few plain-language sentences —
# what this solved and what changed, for whoever asked for the ticket and doesn't read
# diffs — replacing the bare "closed, here's the MR" with something that actually says
# what happened. No file/function/technical references, unlike the independent review
# or testing notes above. On by default; one extra Sonnet-tier turn's cost per
# *successful* task.
CLOSE_REPORT_ENABLED=true

# Composes the closeReport/testingNotes text already generated for this task (above)
# into one plain-text file and attaches it to the Jira issue the moment it transitions
# out of "in progress" — so a tester opens the ticket straight to a document saying what
# changed and how to verify it, instead of reading the comment thread. No extra LLM
# turn: reuses whatever closeReport/testingNotes already produced, skipped entirely if
# both are disabled or both came back empty. On by default.
WORK_REPORT_ENABLED=true

# A baseline-relative gate can be fooled by an agent that skips a previously-failing
# test instead of fixing it (failure count genuinely drops, nothing was actually
# fixed). After every real success, a mechanical (not LLM) check scans the diff for a
# deleted test file, a newly added skip/only/todo marker, or an edit to CI/gate config
# (.gitlab-ci.yml, jest/vitest config, eslint config, the test/lint/build/typecheck
# scripts in package.json). Any hit routes straight to needs_human — never retried,
# since giving the agent another attempt just risks it hiding this better. No extra
# LLM turn, so there's little reason to turn it off outside of debugging it.
GATE_INTEGRITY_CHECK_ENABLED=true

# A new task's worktree branches from repoPath's current local HEAD by default, which
# the harness never fetches/pulls on its own otherwise — it can be days stale by the
# time a task starts. On by default: fetches GITLAB_TARGET_BRANCH first and branches
# from THAT instead, so gates/acceptance tests run against what the MR will really be
# merged into. Only applies to a brand-new worktree, not one being resumed after a
# brief/human-review pause (rebasing in-progress work onto a moving base is a harder,
# separate problem this doesn't attempt).
FRESH_BASE_ENABLED=true

MAX_ITERATIONS=5
# Context policy, as in the CTO fleet: one session per task, continued with --resume;
# Claude Code compacts its own context when the window fills. For 1M-context models
# the compaction point can be raised (the CTO fleet uses 600000 for its devs) — this
# variable is passed through to the agent unchanged:
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=600000
# Sessions are bounded by time, not tokens: a turn whose stream stays silent for
# AGENT_IDLE_TIMEOUT_MS is killed (30 min), and no turn runs past AGENT_TURN_TIMEOUT_MS
# (5 h). A killed implement turn saves its unfinished edits as a "wip: checkpoint"
# commit and the task goes to a human (turn_timeout). 0 disables either one.
AGENT_IDLE_TIMEOUT_MS=1800000
AGENT_TURN_TIMEOUT_MS=18000000
# Session journal: every agent turn's stream-json, secrets masked, in
# .harness-state/tasks/<KEY>/sessions/<time>-<role>.jsonl (tail -f while it runs).
# Journals older than this many days are deleted at bot start; 0 keeps them forever.
SESSION_LOG_RETENTION_DAYS=14
# Opt-in token tools, off by default. Both measure the real context of the turn's LAST
# model call. CONTEXT_BUDGET_TOKENS (0 = off) stops the task and asks a human;
# HANDOFF_ENABLED hands the implement session to a fresh one at HANDOFF_CONTEXT_TOKENS
# with a written note, up to MAX_HANDOFFS times (.harness-state/tasks/<KEY>/handoff-N.md).
CONTEXT_BUDGET_TOKENS=0
HANDOFF_ENABLED=false
HANDOFF_CONTEXT_TOKENS=80000
MAX_HANDOFFS=2
MAX_BUDGET_USD=5
# Checked before touching Jira at all — once either cap is hit the queue
# pauses (doesn't retry tickets, doesn't drain further) until the next day.
DAILY_BUDGET_USD=20
MAX_TASKS_PER_DAY=10

# Telegram bot (BotFather token). ALLOWED_CHAT_IDS is a hard allowlist —
# the bot ignores commands from anyone else, since it can push code and open
# MRs on your behalf. Get your chat id from @userinfobot.
# A dedicated bot from @BotFather (/newbot). Never reuse a token another process
# polls (e.g. the CI review bot): two pollers steal each other's updates.
TELEGRAM_BOT_TOKEN=
# Your numeric id from @userinfobot (private chat with the bot).
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional: numeric Telegram user ids allowed to command/approve. Set it whenever
# TELEGRAM_ALLOWED_CHAT_IDS contains a group — otherwise any group member can approve.
TELEGRAM_ALLOWED_USER_IDS=
# Every claude turn runs with --restricted (no code tools, no WebFetch, file tools
# confined to the worktree, user settings ignored). Set to false only if a live run
# shows it breaks a role.
AGENT_RESTRICTED_MODE=true
IDLE_POLL_SECONDS=300
ACTIVE_POLL_SECONDS=10

# Local-only dashboard opened via /dashboard in Telegram: binds to 127.0.0.1,
# rejects non-loopback Host headers, and its one POST needs a per-process token.
DASHBOARD_PORT=4790

# --- Role fleet (`node dist/cli.js fleet run`, see docs/FLEET.md) ---
# Mail spool and fleet state (worktrees per thread, thread sessions, counters).
# FLEET_MAIL_DIR=~/.xentra-fleet/mail
# FLEET_HOME=~/.xentra-fleet
# Forward letters to xentra/owner into the Telegram chat; reply to answer.
FLEET_BRIDGE_ENABLED=true
# Start gate: daily caps per bucket (Claude in estimated $ and sessions, Codex in sessions).
# Hitting one only stops NEW sessions; letters wait. /fleet_override lifts them for today.
FLEET_CLAUDE_DAILY_USD=30
FLEET_CLAUDE_DAILY_SESSIONS=80
FLEET_CODEX_DAILY_SESSIONS=40
# Watchers: ci-watch (after <watch-ci/>) and jira-watch (keys mailed in the last 7 days).
FLEET_CI_POLL_MS=120000
FLEET_JIRA_POLL_MS=300000
# Merge bot: off (default) | notify (owner gets a Merge button) | auto (bot merges itself).
# Ready = MR open + green CI + every auditor clear on the head commit + no /veto.
FLEET_MERGE_BOT=off
FLEET_MERGE_POLL_MS=300000

# --- mobile-ai (role fleet only; `--repo mobile`). A separate clone for the fleet, with node_modules
# installed (`npm ci`): worktrees symlink it. No emulator here — gates are tsc / expo lint / jest,
# the Android build runs in the repo's own GitLab CI.
MOBILE_REPO_PATH=/Users/aigera/WebstormProjects/fleet/mobile-ai
MOBILE_GITLAB_PROJECT=saqr/mobile-ai
MOBILE_GATE_TYPECHECK=npx tsc --noEmit
MOBILE_GATE_LINT=npx expo lint --max-warnings=0
MOBILE_VERIFY_CMD=npx jest --ci
